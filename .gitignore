# ==== Gevoelige data: NOOIT committeren ====
# SQLite-database (accounts, gezondheidsdata, Garmin-wachtwoord, AI-API-sleutel),
# Garmin-tokens, session-secret, uploads en logs.
data/

# Omgevingsvariabelen / lokale sleutels
.env
.env.*
*.pem
*.key

# ==== Niet-meesturen: builds, caches, scratch ====
__pycache__/
*.py[cod]
venv/
.venv/

# ==== Android TWA/APK (Bubblewrap) ====
twa/*.keystore
twa/*.jks
twa/keystore-*.txt
twa/*.aab
twa/app-release-*.apk
twa/app-release-*.idsig

# eigen scratch-bestanden en -logs (beginnen met _)
_*

# OS-/editor-meuk
Thumbs.db
.DS_Store

# build-logjes van de TWA-toolchain (worden per build opnieuw aangemaakt)
twa/build-*.txt

# TWA-toolchain: sleutel (zonder extensie) en gegenereerde build-dirs
twa/android-keystore
twa/build/
twa/.gradle/

# gradle-buildoutputs zitten onder twa/app/build
twa/app/build/
twa/.gradle/

# === persoonlijk/geidentificeerd: bewust NIET in de publieke repo ===
# De Android-TWA-toolchain en de Digital Asset Links bevatten het eigen
# domein, package-id en de sleutel-vingerafdruk; deze blijven lokaal.
twa/
assetlinks.json
